@model ML.Candidato
@{
    ViewBag.Title = "Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<h2>Agendar cita a candidatos</h2>
<div class="container">
    @if (Model.vacante.Vacantes != null)
    {
        using (Html.BeginForm("Principal", "AgendarCita", FormMethod.Post))
        {
            <div class="row g-1">
                <div class="col-3">
                    @Html.DropDownListFor(Model => Model.vacante.IdVacante, new SelectList(Model.vacante.Vacantes, "IdVacante", "Nombre"),
                   "Selecciona una opcion", new { @class = "form-select rounded-pill border border-success border border-2", @id = "Vacante" })
                </div>
                <div class="col-3 text-lg-center">
                    <button class="btn btn-success fw-bold btn-lg text-center" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        }

    }
    else
    {
        <div>
            <h2> No se han podido encontrar vacantes </h2>
        </div>
    }
    <br />
    @if (Model.Candidatos != null)
    {
        <div class="row">
            <div class="col">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col" class="text-center">#</th>
                            <th scope="col" class="text-center">Candidato</th>
                            <th scope="col" class="text-center">Datos contacto</th>
                            <th scope="col" class="text-center">Vacante</th>
                            <th scope="col" class="text-center">Agendar cita</th>
                            <th scope="col" class="text-center">Estatus cita</th>
                        </tr>
                    </thead>
                    <tbody>

                        @{ int contador = 1;}
                        @foreach (ML.Candidato candidato in Model.Candidatos)
                        {
                            <tr>
                                <td>@contador</td>
                                <td class="text-center">
                                    <div>
                                        @if (candidato.Foto == null)
                                        {
                                            <img id="fotoPerfil" class="avatar" src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740"
                                                 width="60" height="60">
                                        }
                                        else
                                        {
                                            <img src="data:image/*;base64,@Convert.ToBase64String(candidato.Foto)" class="avatar" alt="Sin foto"
                                                 width="60" height="60">
                                        }
                                        <div style="margin-left: 4px">@candidato.Nombre @candidato.ApellidoPaterno @candidato.ApellidoMaterno</div>

                                        <span class="badge text-bg-info">
                                            Edad: @candidato.Edad años
                                        </span>

                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-telephone-fill"></i>
                                        @candidato.Telefono
                                    </span>
                                    <br>
                                    <span class="badge text-bg-primary">
                                        <i class="bi bi-envelope-at-fill"></i>
                                        @candidato.Correo
                                    </span>
                                    <br>
                                    <span class="badge text-bg-dark">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        @candidato.Direccion
                                    </span>
                                </td>
                                <td class="text-center">
                                    @candidato.vacante.Nombre
                                    <br />
                                    Bolsa de trabajo: @candidato.bolsaTrabajo.Nombre
                                </td>
                                @if (candidato.cita.IdCita == 0)
                                {

                                    <td class="text-center fs-5">
                                        <a href="@Url.Action("EliminarCandidato","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                           class="btn btn-dark btn-sm badge text-white"role="button">
                                            <i class="bi bi-pencil-square"></i> Agendar
                                        </a>
                                    </td>
                                    <td class=" text-center fs-4">
                                        <span class="badge text-bg-light">
                                            <i class="bi bi-calendar2-x-fill"></i>
                                            Sin cita
                                        </span>
                                    </td>
                                }
                                else
                                {
                                    <td class="text-center fs-5">
                                        <a href="@Url.Action("EliminarCandidato","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                           class="btn btn-warning btn-sm badge text-black" role="button">
                                            <i class="bi bi-pen-fill"></i> Editar
                                        </a>
                                    </td>
                                    <td class=" text-center fs-5">
                                        <span class="badge text-bg-light">
                                            <i class="bi bi-calendar-week-fill"></i>
                                            cita agendada
                                        </span>
                                    </td>
                                }
                            </tr>

                            @*<div class="col-lg-4 col-md-4">
                                    <div class="card shadow-lg">
                                        <div class="card-body text-center p-10">
                                            @if (candidato.Foto == null)
                                            {
                                                <img src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740" class="rounded-circle img-fluid" style="width: 150px;" />
                                            }
                                            else
                                            {
                                                <img src="data:image/*;base64,@Convert.ToBase64String(candidato.Foto)" class="rounded-circle img-fluid" style="width: 150px;" />
                                            }
                                            <h5 class="card-title fs-5">@candidato.Nombre @candidato.ApellidoPaterno @candidato.ApellidoMaterno </h5>
                                            <p class="card-text">
                                                Edad: @candidato.Edad años
                                                <br />
                                                <span class="badge text-bg-dark text-wrap">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    @candidato.Direccion
                                                </span>
                                                <br />
                                                <span class="badge text-bg-success">
                                                    <i class="bi bi-telephone-fill"></i>
                                                    @candidato.Telefono
                                                </span>
                                                <br />
                                                <span class="badge text-bg-primary">
                                                    <i class="bi bi-envelope-at-fill"></i>
                                                    @candidato.Correo
                                                </span>
                                                <br />
                                            </p>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item">carrera: @candidato.carrera.Nombre</li>
                                            <li class="list-group-item"> @candidato.universidad.Nombre</li>
                                            <li class="list-group-item">promedio universidad: @candidato.promedio.PromedioUniversidad</li>
                                        </ul>
                                        <div class="card-body p-10">
                                            <p>
                                                Vacante: @candidato.vacante.Nombre
                                                <br />
                                                Bolsa de trabajo: @candidato.bolsaTrabajo.Nombre
                                            </p>
                                        </div>
                                        <div class="card-body d-flex p-10">
                                            <a href="@Url.Action("EliminarCandidato","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                               class="btn btn-danger" onclick="return confirm('Seguro que deseas eliminar el registro?')" role="button">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                            <a href="@Url.Action("Formulario","Candidato", new {IdCandidato = candidato.IdCandidato, IdPromedio = candidato.promedio.IdPromedio})"
                                               class="btn btn-warning text-lg-center" role="button">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            @if (candidato.Curriculum != null)
                                            {
                                                <div class="ms-auto">
                                                    <a href="@Url.Action("Download","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                                       class="btn btn-info text-lg-center align-content-end" role="button">
                                                        <i class="bi bi-download"></i> Descargar CV
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ms-auto">
                                                    <p class="text-bg-info"> No cuenta con CV cargado</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>*@
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div>
            <div class="card shadow-lg border text-center p-4">
                <h2>No se han encontrado registros, favor de buscar</h2>
                <center>
                    <img src="https://cdn-icons-png.flaticon.com/512/1329/1329920.png" width="200" height="200" />
                </center>
            </div>
        </div>
    }
</div>


