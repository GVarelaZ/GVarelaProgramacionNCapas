@model ML.Candidato
@{
    ViewBag.Title = "formCita";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            @if (Model.cita.IdCita != 0)
            {
                <h2>EDITAR CITA </h2>
            }
            else
            {
                <h2>AGENDAR CITA </h2>
                <h5>Selecciona el tipo de entrevista a realizar</h5>
                <button id="btnPresencial" class="btn btn-outline-success fw-bold text-center" onclick="toggleView('formPresencial'), bloquearSelect()">Entrevista presencial</button>
                <button id="btnRemoto" class="btn btn-outline-success fw-bold text-center" onclick="toggleView('formRemoto'), bloquearSelect()">Entrevista remota</button>
                <br />
                <br />
            }
        </div>
        <hr />
        <div class="col mb-2 d-flex gap-3 justify-content-center">
            <div class="card card-margin">
                <div class="card-header no-border">
                    <h5 class="card-title">Aspirante</h5>
                </div>
                <div class="card-body pt-0">
                    <div class="widget-49">
                        <div class="widget-49-title-wrapper">
                            <div class="widget-49-date-primary text-center">
                                @if (Model.Foto == null)
                                {
                                    <img src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740" class="rounded-circle img-fluid" style="width: 75px;" />
                                }
                                else
                                {
                                    <img src="data:image/*;base64,@Convert.ToBase64String(Model.Foto)" class="rounded-circle img-fluid" style="width: 75px; height:75px" />
                                }
                                <span class="widget-49-pro-title">  @Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</span>
                            </div>
                            <div class="widget-49-meeting-info">
                            </div>
                        </div>
                        <div class="widget-49-date-primary text-center">
                            <p> Correo: @Model.Correo</p>
                            <p> Telefono: @Model.Telefono</p>
                        </div>
                        <div class="widget-49-date-primary text-center">
                            <span class="badge text-bg-dark">@Model.carrera.Nombre</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-8 p-3">

                @if (Model.cita.IdCita == 0)
                {
                    <div id="formularioPresencial" style="display:none;">
                        <div class="card card-margin text-center p-3">
                            <h2>AGENDAR ENTREVISTA PRESENCIAL</h2>
                            @using (Html.BeginForm("FormCita", "AgendarCita", FormMethod.Post))
                            {
                                @Html.HiddenFor(Model => Model.cita.IdCita)
                                @Html.HiddenFor(Model => Model.IdCandidato)
                                <div class="row text-center">
                                    <div class="col-6 mb-3">
                                        <label class="form-label">Fecha y hora</label>
                                        @Html.TextBoxFor(Model => Model.cita.FechaHora, new { @class = "form-control", @name = "idCalendario", @id = "idCalendario" })
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="form-label">Piso</label>
                                        @Html.DropDownListFor(Model => Model.cita.piso.IdPiso, new SelectList(Model.cita.piso.Pisos, "IdPiso", "Nombre"), new { @class = "form-select" })
                                    </div>
                                    <div class="col-6 mb-3 text-center">
                                        <label class="form-label">Estatus cita</label>
                                        @Html.DropDownListFor(Model => Model.cita.estatusCita.IdEstatusCita, new SelectList(Model.cita.estatusCita.estatusCitas, "IdEstatusCita", "Nombre"), new { @class = "form-select", @id = "DLLCita" })
                                    </div>
                                    <div class="col-6 mb-3">
                                        <br />
                                        <button class="btn btn-outline-success fw-bold text-center" type="submit">AGENDAR</button>
                                        <a class="btn btn-outline-danger border-5 fw-bold text-center" href="@Url.Action("Principal","AgendarCita")">Cancelar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div id="formularioRemoto" style="display:none;">
                        <div class="card card-margin text-center p-3">
                            <h2>AGENDAR ENTREVISTA REMOTA</h2>
                            @using (Html.BeginForm("FormCita", "AgendarCita", FormMethod.Post))
                            {
                                @Html.HiddenFor(Model => Model.cita.IdCita)
                                @Html.HiddenFor(Model => Model.IdCandidato)
                                <div class="row text-center">
                                    <div class="col-6 mb-3">
                                        <label class="form-label">Fecha y hora</label>
                                        @Html.TextBoxFor(Model => Model.cita.FechaHora, new { @class = "form-control", @name = "idCalendario", @id = "idCalendario" })
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="form-label">Url</label>
                                        @Html.TextBoxFor(Model => Model.cita.Url, new { @class = "form-control" })
                                    </div>
                                    <div class="col-6 mb-3 text-center">
                                        <label class="form-label">Estatus cita</label>
                                        @Html.DropDownListFor(Model => Model.cita.estatusCita.IdEstatusCita, new SelectList(Model.cita.estatusCita.estatusCitas, "IdEstatusCita", "Nombre"), new { @class = "form-select", @id = "DLLCita" })
                                    </div>
                                    <div class="col-6 mb-3">
                                        <br />
                                        <button class="btn btn-outline-success fw-bold text-center" type="submit">AGENDAR</button>
                                        <a class="btn btn-outline-danger fw-bold text-center" href="@Url.Action("Principal","AgendarCita")">Cancelar</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card card-margin text-center p-3">
                        <h2>EDITAR ENTREVISTA</h2>
                        @using (Html.BeginForm("FormCita", "AgendarCita", FormMethod.Post))
                        {
                            @Html.HiddenFor(Model => Model.IdCandidato)
                            @Html.HiddenFor(Model => Model.cita.IdCita)
                            <div class="row text-center">
                                <div class="col-6 mb-3">
                                    <label class="form-label">Fecha y hora</label>
                                    @Html.TextBoxFor(Model => Model.cita.FechaHora, new { @class = "form-control", @name = "FechaHora", @id = "idCalendario" })
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label">Piso</label>
                                    @Html.DropDownListFor(Model => Model.cita.piso.IdPiso, new SelectList(Model.cita.piso.Pisos, "IdPiso", "Nombre"), new { @class = "form-select" })
                                </div>
                                <div class="col-6 mb-3 text-center">
                                    <label class="form-label">Estatus cita</label>
                                    @Html.DropDownListFor(Model => Model.cita.estatusCita.IdEstatusCita, new SelectList(Model.cita.estatusCita.estatusCitas, "IdEstatusCita", "Nombre"), new { @class = "form-select" })
                                </div>
                                <div class="col-6 mb-3">
                                    <br />
                                    <button class="btn btn-outline-success fw-bold text-center" type="submit">GUARDAR</button>
                                    <a class="btn btn-outline-danger fw-bold text-center" href="@Url.Action("Principal","AgendarCita")">Cancelar</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/jquery-3.7.0.js"></script>
<!-- Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/Scripts/Cita/formulario.js"></script>

