@model ML.Candidato
@{
    ViewBag.Title = "Formulario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Formulario</h2>

<div class="col-12">
    <div class="card">
        <div class="px-4 py-3 border-bottom">
            <h4 class="card-title mb-0">Registro de candidatos</h4>
        </div>
        @using (Html.BeginForm("Formulario", "Candidato", FormMethod.Post))
        {
            @Html.HiddenFor(Model => Model.IdCandidato)
            @Html.HiddenFor(Model => Model.promedio.IdPromedio)
            <div class="card-body p-4">
                <h5 class="fs-4 fw-semibold mb-4">Info personal</h5>
                <div class="row">
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Nombre(s)</label>
                            @Html.TextBoxFor(Model => Model.Nombre, new { @class = "form-control", @id = "nombre" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Edad</label>
                            @Html.TextBoxFor(Model => Model.Edad, new { @class = "form-control", @type = "number", @value = "18", @min = "18", @max = "70" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Direccion</label>
                            @Html.TextAreaFor(Model => Model.Direccion, new { @class = "form-control", @id = "direccion" })
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Apellido paterno</label>
                            @Html.TextBoxFor(Model => Model.ApellidoPaterno, new { @class = "form-control", @id = "apellidoPaterno" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Correo</label>
                            <div class="input-group">
                                @Html.TextBoxFor(Model => Model.Correo, new { @class = "form-control", @type = "text", @id = "correo" })
                                <span class="input-group-text px-6" id="basic-addon1">@@example.com</span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Foto perfil</label>
                            <input name="imagenCargada" id="imagenInput" type="file" class="form-control" style="border-width:3px" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Apellido materno</label>
                            @Html.TextBoxFor(Model => Model.ApellidoMaterno, new { @class = "form-control", @id = "apellidoMaterno" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Telefono</label>
                            @Html.TextBoxFor(Model => Model.Telefono, new { @class = "form-control", @id = "telefono" })
                        </div>
                        <div class="mb-4 text-md-center">
                            <img id="fotoPerfil" class="avatar rounded-2" src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740"
                                 width="100" height="100">
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 border-bottom">
                <hr />
                <h5 class="fs-4 fw-semibold mb-4">Escolaridad y vacante</h5>
                <div class="row">
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Pomedio Universidad</label>
                            @Html.TextBoxFor(Model => Model.promedio.PromedioUniversidad, new { @class = "form-control", @id = "proUniversidad" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Carrera</label>
                            @Html.DropDownListFor(Model => Model.carrera.IdCarrera, new SelectList(Model.carrera.Carreras, "IdCarrera", "Nombre"),
                            "Selecciona una opcion", new { @class = "form-select", @id = "Carrera" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Vacante</label>
                            @Html.DropDownListFor(Model => Model.vacante.IdVacante, new SelectList(Model.vacante.Vacantes, "IdVacante", "Nombre"),
                            "Selecciona una opcion", new { @class = "form-select", @id = "vacante" })
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Pomedio Preparatoria</label>
                            @Html.TextBoxFor(Model => Model.promedio.PromedioPreparatoria, new { @class = "form-control", @id = "proPreparatoria" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Universidad</label>
                            @Html.DropDownListFor(Model => Model.universidad.IdUniveridad, new SelectList(Model.universidad.Universidades, "IdUniveridad", "Nombre"),
                            "Selecciona una opcion", new { @class = "form-select", @id = "Universidad" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Bolsa de trabajo</label>
                            @Html.DropDownListFor(Model => Model.bolsaTrabajo.IdBolsaTrabajo, new SelectList(Model.bolsaTrabajo.BolsasTrabajo, "IdbolsaTrabajo", "Nombre"),
                            "Selecciona una opcion", new { @class = "form-select", @id = "bolsaTrabajo" })
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Pomedio Secundaria</label>
                            @Html.TextBoxFor(Model => Model.promedio.PromedioSecundaria, new { @class = "form-control", @id = "proSecundaria" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Curriculum</label>
                            <input name="cvCargada" id="archivoInput" type="file" class="form-control" style="border-width:3px" />
                        </div>
                        <div class="mb-4 text-md-center">
                            <img id="fotoPerfil" class="avatar rounded-1" src="https://cdn.iconscout.com/icon/premium/png-512-thumb/clear-file-594302.png?f=webp&w=256"
                                 width="100" height="100">
                        </div>
                    </div>
                </div>
                <br />
                <div class="col-12">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-primary">Submit</button>
                        <button class="btn bg-danger-subtle text-danger">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

