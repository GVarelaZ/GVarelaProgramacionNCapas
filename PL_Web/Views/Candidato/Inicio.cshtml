@model ML.Candidato
@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<h2>Busqueda de Candidatos</h2>
<div class="container">
    @if (Model.vacante.Vacantes != null)
    {
        using (Html.BeginForm("Inicio", "Candidato", FormMethod.Post))
        {
            <div class="row g-1">
                <div class="col-3">
                    @Html.DropDownListFor(Model => Model.vacante.IdVacante, new SelectList(Model.vacante.Vacantes, "IdVacante", "Nombre"),
                   "Selecciona una opcion", new { @class = "form-select rounded-pill border border-success border border-2", @id = "Vacante" })
                </div>
                <div class="col-3 text-lg-center">
                    <button class="btn btn-success fw-bold btn-lg text-center" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                <div class="col-6 text-lg-end">
                    <a href="@Url.Action("Formulario","Candidato")"
                       class="btn btn-primary btn-lg text-lg-center" role="button">
                        <i class="bi bi-person-plus-fill"></i> Agregar
                    </a>
                </div>
            </div>
        }

    }
    else
    {
        <div>
            <h2> No se han podido encontrar vacantes </h2>
        </div>
    }
    <br />

    <!-- Botones para cambiar entre vistas -->
    <div class="d-flex justify-content-center my-3">
        <button id="btnTable" class="btn btn-primary mx-2" onclick="toggleView('table')">Ver en Tabla</button>
        <button id="btnCard" class="btn btn-primary mx-2" onclick="toggleView('card')">Ver en Cards</button>
    </div>
    <!-- Vista en Tabla -->
    <div id="tableView" style="display: block;">
        @if (Model.Candidatos != null && Model.Candidatos.Count > 0)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th class="text-center">Candidato</th>
                        <th class="text-center">Contacto</th>
                        <th class="text-center">Educación</th>
                        <th class="text-center">Vacante y Bolsa</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                @{int contador = 1; }
                <tbody>
                    @foreach (ML.Candidato candidato in Model.Candidatos)
                    {
                        <tr>
                            <td>@contador</td>
                            <td class="text-center">
                                <div>
                                    @if (candidato.Foto == null)
                                    {
                                        <img id="fotoPerfil" class="avatar" src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740" width="60" height="60">
                                    }
                                    else
                                    {
                                        <img src="data:image/*;base64,@Convert.ToBase64String(candidato.Foto)" class="avatar" alt="Sin foto" width="60" height="60">
                                    }
                                    <div style="margin-left: 4px">
                                        @candidato.Nombre @candidato.ApellidoPaterno @candidato.ApellidoMaterno
                                    </div>
                                    <span class="badge text-bg-info">Edad: @candidato.Edad años</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge text-bg-success">
                                    <i class="bi bi-telephone-fill"></i>
                                    @candidato.Telefono
                                </span>
                                <br>
                                <span class="badge text-bg-primary">
                                    <i class="bi bi-envelope-at-fill"></i>
                                    @candidato.Correo
                                </span>
                                <br>
                                <span class="badge text-bg-dark">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @candidato.Direccion
                                </span>
                            </td>
                            <td class="text-center">
                                carrera: @candidato.carrera.Nombre
                                <br />
                                @candidato.universidad.Nombre
                                <br />
                                promedio universidad: @candidato.promedio.PromedioUniversidad
                            </td>
                            <td class="text-center">
                                Vacante: @candidato.vacante.Nombre
                                <br />
                                Bolsa de trabajo: @candidato.bolsaTrabajo.Nombre
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("EliminarCandidato", "Candidato", new { IdCandidato = candidato.IdCandidato })" class="btn btn-danger" onclick="return confirm('Seguro que deseas eliminar el registro?')" role="button">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                                <a href="@Url.Action("Formulario", "Candidato", new { IdCandidato = candidato.IdCandidato, IdPromedio = candidato.promedio.IdPromedio })" class="btn btn-warning" role="button">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            </td>
                        </tr>
                        contador = contador + 1;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="card shadow-lg border text-center p-4">
                <h2>No se han encontrado registros, favor de buscar</h2>
                <center>
                    <img src="https://cdn-icons-png.flaticon.com/512/1329/1329920.png" width="200" height="200" />
                </center>
            </div>
        }
    </div>

    <!-- Vista en Cards -->
    <div id="cardView" style="display: none;">
        @if (Model.Candidatos != null)
        {
            <div class="row">
                @foreach (ML.Candidato candidato in Model.Candidatos)
                {
                    <div class="col-lg-4 col-md-4">
                        <div class="card shadow-lg overflow-scroll h-75 w-100" style="-ms-overflow-style: none; scrollbar-width: none;" >
                            <div class="card-body text-center p-10">
                                @if (candidato.Foto == null)
                                {
                                    <img src="https://img.freepik.com/vector-gratis/avatar-personaje-empresario-aislado_24877-60111.jpg?t=st=1740679301~exp=1740682901~hmac=8d0df42d89f7a73d080b188cd7449336b9e10547b4c3751fa72055ae09087bf3&w=740" class="rounded-circle img-fluid" style="width: 150px;" />
                                }
                                else
                                {
                                    <img src="data:image/*;base64,@Convert.ToBase64String(candidato.Foto)" class="rounded-circle img-fluid" style="width: 150px; height:150px" />
                                }
                                <h5 class="card-title fs-5">@candidato.Nombre @candidato.ApellidoPaterno @candidato.ApellidoMaterno </h5>
                                <p class="card-text">
                                    Edad: @candidato.Edad años
                                    <br />
                                    <span class="badge text-bg-dark text-wrap">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        @candidato.Direccion
                                    </span>
                                    <br />
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-telephone-fill"></i>
                                        @candidato.Telefono
                                    </span>
                                    <br />
                                    <span class="badge text-bg-primary">
                                        <i class="bi bi-envelope-at-fill"></i>
                                        @candidato.Correo
                                    </span>
                                    <br />
                                </p>
                            </div>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">carrera: @candidato.carrera.Nombre</li>
                                <li class="list-group-item"> @candidato.universidad.Nombre</li>
                                <li class="list-group-item">promedio universidad: @candidato.promedio.PromedioUniversidad</li>
                            </ul>
                            <div class="card-body p-10">
                                <p>
                                    Vacante: @candidato.vacante.Nombre
                                    <br />
                                    Bolsa de trabajo: @candidato.bolsaTrabajo.Nombre
                                </p>
                            </div>
                            <div class="card-body d-flex p-10">
                                <a href="@Url.Action("EliminarCandidato","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                   class="btn btn-danger" onclick="return confirm('Seguro que deseas eliminar el registro?')" role="button">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                                <a href="@Url.Action("Formulario","Candidato", new {IdCandidato = candidato.IdCandidato, IdPromedio = candidato.promedio.IdPromedio})"
                                   class="btn btn-warning text-lg-center" role="button">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                @if (candidato.Curriculum != null)
                                {
                                    <div class="ms-auto">
                                        <a href="@Url.Action("Download","Candidato", new {IdCandidato = candidato.IdCandidato})"
                                           class="btn btn-info text-lg-center align-content-end" role="button">
                                            <i class="bi bi-download"></i> Descargar CV
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="ms-auto">
                                        <p class="text-bg-info"> No cuenta con CV cargado</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div>
                <div class="card shadow-lg border text-center p-4">
                    <h2>No se han encontrado registros, favor de buscar</h2>
                    <center>
                        <img src="https://cdn-icons-png.flaticon.com/512/1329/1329920.png" width="200" height="200" />
                    </center>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Función para alternar entre las vistas
    function toggleView(view) {
        if (view === 'table') {
            document.getElementById('tableView').style.display = 'block';
            document.getElementById('cardView').style.display = 'none';
            document.getElementById('btnTable').classList.add('btn-active');
            document.getElementById('btnCard').classList.remove('btn-active');
        } else {
            document.getElementById('tableView').style.display = 'none';
            document.getElementById('cardView').style.display = 'block';
            document.getElementById('btnCard').classList.add('btn-active');
            document.getElementById('btnTable').classList.remove('btn-active');
        }
    }
</script>
